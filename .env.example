# For local use:
SITE_ADDRESS=http://localhost
FRONTEND_ORIGIN=http://localhost

# For production with automatic HTTPS, replace both with your real domain, for example:
# SITE_ADDRESS=shop.example.ru
# FRONTEND_ORIGIN=https://shop.example.ru
ACME_EMAIL=admin@example.ru

POSTGRES_DB=workkit
POSTGRES_USER=workkit
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD

ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_ADMIN_TOKEN
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_JWT_SECRET
ACCESS_TOKEN_MINUTES=720
APP_NAME="WorkKit Studio API"
