# For local use:
SITE_ADDRESS=http://localhost
FRONTEND_ORIGIN=http://localhost

# For production with automatic HTTPS, replace both with your real domain, for example:
# SITE_ADDRESS=shop.example.ru
# FRONTEND_ORIGIN=https://shop.example.ru
ACME_EMAIL=admin@example.ru

POSTGRES_DB=workkit
POSTGRES_USER=workkit
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD

ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_ADMIN_TOKEN
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_JWT_SECRET
ACCESS_TOKEN_MINUTES=720
APP_NAME="WorkKit Studio API"

# --- Mulen Pay (оплата). Пока ключи пустые, заказы создаются без перехода на оплату.
# Ключи: личный кабинет Mulen Pay → магазин → API.
MULENPAY_API_KEY=
MULENPAY_SECRET_KEY=
MULENPAY_SHOP_ID=
# Callback не нужен: сайт сам проверяет статус оплаты в Mulen Pay (при просмотре заказа и фоном).
# Как часто фоном проверять неоплаченные заказы за последние 48 часов, в секундах:
PAYMENT_SYNC_INTERVAL=60
# Необязательно: только если всё же укажете callback URL в кабинете Mulen Pay.
MULENPAY_CALLBACK_TOKEN=
# MULENPAY_BASE_URL=https://api.mulenpay.com/api

# --- SMTP для кодов подтверждения e-mail. Пока SMTP_HOST пустой, регистрация проходит без кода.
# Порт 465 → SMTP_SECURITY=ssl, порт 587 → SMTP_SECURITY=starttls.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя, обычно совпадает с SMTP_USER, например no-reply@ваш-домен.ru
SMTP_FROM=
